  "version": 1,
  "time": { "from": "now-3h", "to": "now" },
  "panels": [

    { "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }, "id": 1, "title": "Service Status", "type": "row" },

    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "unit": "none",
          "noValue": "Stopped",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 30 }] },
          "mappings": [
            { "type": "range", "options": { "from": 0, "to": 29, "result": { "text": "Running", "color": "green", "index": 0 } } },
            { "type": "range", "options": { "from": 30, "to": 1000000, "result": { "text": "Issues", "color": "orange", "index": 1 } } },
            { "type": "special", "options": { "match": "null", "result": { "text": "Stopped", "color": "red", "index": 2 } } }
          ]
        },
        "overrides": []
      },
      "gridPos": { "h": 3, "w": 5, "x": 0, "y": 1 },
      "id": 2,
      "options": { "colorMode": "background", "graphMode": "none", "justifyMode": "center", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "name" },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "max(time() - container_last_seen{container_label_com_docker_compose_service=\"freeman-backend\",name!=\"\"})", "instant": true, "refId": "A" }],
      "title": "Backend",
      "type": "stat"
