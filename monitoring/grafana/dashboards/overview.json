          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rate(container_cpu_usage_seconds_total{container_label_com_docker_compose_service=~\"freeman-backend|freeman-bot|freeman-admin-bot|telegram-bot-api|freeman-minio\",name!=\"\"}[2m]) * 100",
          "legendFormat": "{{ container_label_com_docker_compose_service }}",
          "refId": "A"
        }
      ],
      "title": "CPU Usage %",
      "type": "timeseries"
    },

    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
